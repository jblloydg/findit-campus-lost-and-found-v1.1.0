# Copy to .env (never commit .env). Every value here is read from environment variables.
DJANGO_SECRET_KEY=replace-with-a-long-random-value-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave empty for local SQLite and single-process chat.
# PostgreSQL example: postgres://findit:PASSWORD@db-host:5432/findit
DATABASE_URL=
REDIS_URL=

# Production example only:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=findit.example.edu
# DJANGO_CSRF_TRUSTED_ORIGINS=https://findit.example.edu
# DJANGO_SSL_REDIRECT=1
# DJANGO_BEHIND_PROXY=1            # only if a trusted proxy terminates HTTPS
# DJANGO_HSTS_SECONDS=3600          # raise to 31536000 once HTTPS is confirmed

# Password-reset email (leave DJANGO_EMAIL_HOST empty to print emails to the console)
# DJANGO_EMAIL_HOST=smtp.example.edu
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_DEFAULT_FROM_EMAIL=Find-IT <no-reply@findit.example.edu>

# Sign-in throttling
# FINDIT_LOGIN_FAILURE_LIMIT=5
# FINDIT_LOGIN_LOCKOUT_SECONDS=900

# Backups (folder must NOT be inside static/ or media/)
# FINDIT_BACKUP_DIR=C:\FindIT-backups
# FINDIT_BACKUP_RETENTION_DAYS=14
# FINDIT_BACKUP_MIN_KEEP=7

# Logs
# FINDIT_LOG_DIR=
